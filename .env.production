# ============================================
# PRODUCTION ENVIRONMENT (Cloud)
# ============================================

ENVIRONMENT=production

# ============================================
# DATABASE
# ============================================
DB_HOST=<YOUR_DB_HOST>
DB_PORT=<YOUR_DB_PORT>
DB_USER=<YOUR_DB_USER>
DB_PASS=<YOUR_DB_PASS>
DB_NAME=<YOUR_DB_NAME>
DB_URL=<YOUR_DATABASE_URL>

# Connection Pool (larger for production)
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=5m

# ============================================
# REDIS
# ============================================
REDIS_URL=<YOUR_REDIS_URL>
REDIS_MAX_CONNS=10
REDIS_MIN_IDLE_CONNS=3
REDIS_POOL_TIMEOUT=1s

# ============================================
# NATS (Optional - set if using)
# ============================================
NATS_URL=<YOUR_NATS_URL>

# ============================================
# RESEND EMAIL
# ============================================
EMAIL_PROVIDER=resend
EMAIL_FROM_ADDRESS=no-reply@example.local
EMAIL_FROM_NAME=Healthcare Access Connector

# Resend API
RESEND_API_KEY=replace_me

# Email Addresses
EMAIL_NOREPLY_ADDRESS=no-reply@example.local
EMAIL_SUPPORT_ADDRESS=support@example.local
EMAIL_HEALTH_ADDRESS=health@example.local

# Email Performance
EMAIL_MAX_WORKERS=10
EMAIL_QUEUE_SIZE=100
EMAIL_CONNECTION_POOL_SIZE=5
EMAIL_TIMEOUT=30s
EMAIL_RETRY_MAX_ATTEMPTS=3
EMAIL_RETRY_DELAY=2s

# ============================================
# SECURITY (Production values)
# ============================================
JWT_SECRET=replace_me
JWT_EXPIRY_HOURS=24

# Bcrypt (higher cost for production)
BCRYPT_COST=12

# Login Security
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINS=5

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=8080
LOG_LEVEL=info
TIMEOUT_SECONDS=30

# Server Timeouts
READ_TIMEOUT=10s
WRITE_TIMEOUT=10s
IDLE_TIMEOUT=60s

# ============================================
# CORS (Specific origins in production)
# ============================================
ALLOWED_ORIGINS=https://example.local,https://www.example.local

# ============================================
# RATE LIMITING (Stricter in production)
# ============================================
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20

# ============================================
# CACHING
# ============================================
CACHE_ENABLED=true
CACHE_TTL_MINUTES=5
CACHE_DEFAULT_TTL=5m
CACHE_USER_TTL=10m
CACHE_SESSION_TTL=1m
CACHE_TOKEN_TTL=1m

# ============================================
# PERFORMANCE MONITORING
# ============================================
METRICS_ENABLED=true
METRICS_PORT=9090
PROFILING_ENABLED=false
PROFILING_PORT=6060

# Email Monitoring
EMAIL_METRICS_ENABLED=true
EMAIL_LOG_LEVEL=info

# ============================================
# TEMPLATES
# ============================================
EMAIL_TEMPLATES_DIR=./internal/email/templates/assets
EMAIL_DEFAULT_LOCALE=en

# ============================================
# FRONTEND
# ============================================
FRONTEND_URL=https://example.local

# ============================================
# HTTP CLIENT
# ============================================
HTTP_CLIENT_TIMEOUT=30s
HTTP_MAX_IDLE_CONNS=100
HTTP_MAX_CONNS_PER_HOST=10
HTTP_IDLE_CONN_TIMEOUT=90s

# ============================================
# AI (Optional)
# ============================================
AI_ENABLED=false
AI_MODEL=openai/gpt-oss-20b:fastest
AI_REQUEST_TIMEOUT=30s
AI_MAX_TOKENS=512

# ============================================
# WEBSOCKET
# ============================================
WS_PING_INTERVAL=30s
WS_PONG_WAIT=60s
WS_WRITE_WAIT=10s
WS_MAX_MESSAGE_BYTES=8192
WS_SEND_CHANNEL_BUFFER=256
