# ============================================
# Healthcare Access Connector - Environment Variables
# ============================================
# WARNING: This file contains PLACEHOLDERS only.
# Replace all <REPLACE_WITH_...> values before use.
# Do NOT commit real secrets to git.
# ============================================

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>?sslmode=require

# Connection Pool
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=5m

# ============================================
# REDIS
# ============================================
REDIS_URL=redis://<REDIS_HOST>:6379

# ============================================
# NATS (Optional)
# ============================================
NATS_URL=nats://<NATS_HOST>:4222

# ============================================
# SECURITY
# ============================================
# Generate with: openssl rand -base64 32
JWT_SECRET=replace_me
JWT_EXPIRY_HOURS=24
SMS_ENABLED=false

# Bcrypt
BCRYPT_COST=12

# Login Security
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINS=5

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=8080
ENVIRONMENT=production
TIMEOUT_SECONDS=30
LOG_LEVEL=info

# Server Timeouts
READ_TIMEOUT=10s
WRITE_TIMEOUT=10s
IDLE_TIMEOUT=60s

# ============================================
# CORS CONFIGURATION
# ============================================
# Comma-separated list of allowed origins (NO TRAILING SLASHES)
ALLOWED_ORIGINS=https://<YOUR_DOMAIN>,https://www.<YOUR_DOMAIN>

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_RPS=50
RATE_LIMIT_BURST=100

# ============================================
# EMAIL CONFIGURATION
# ============================================
EMAIL_PROVIDER=smtp
EMAIL_FROM_ADDRESS=noreply@<YOUR_DOMAIN>
EMAIL_FROM_NAME=Healthcare Access Connector

# SMTP Configuration
SMTP_HOST=<SMTP_HOST>
SMTP_PORT=587
SMTP_USERNAME=replace_me
SMTP_PASSWORD=replace_me
SMTP_USE_TLS=true

# Resend (alternative) — set EMAIL_PROVIDER=resend and configure RESEND_API_KEY
# AWS SES Configuration (Alternative to SMTP) — set EMAIL_PROVIDER=ses and configure AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY

# ============================================
# CACHING
# ============================================
CACHE_ENABLED=true
CACHE_TTL_MINUTES=5
CACHE_DEFAULT_TTL=5m
CACHE_USER_TTL=10m
CACHE_SESSION_TTL=1m
CACHE_TOKEN_TTL=1m

# ============================================
# PERFORMANCE MONITORING
# ============================================
METRICS_ENABLED=true
METRICS_PORT=9090
PROFILING_ENABLED=false
PROFILING_PORT=6060

# ============================================
# TEMPLATES
# ============================================
EMAIL_TEMPLATES_DIR=./internal/email/templates/assets
EMAIL_DEFAULT_LOCALE=en

# ============================================
# FRONTEND
# ============================================
FRONTEND_URL=https://<YOUR_DOMAIN>

# ============================================
# HTTP CLIENT
# ============================================
HTTP_CLIENT_TIMEOUT=30s
HTTP_MAX_IDLE_CONNS=100
HTTP_MAX_CONNS_PER_HOST=10
HTTP_IDLE_CONN_TIMEOUT=90s

# ============================================
# HEALTHCARE SPECIFIC
# ============================================
APPOINTMENT_REMINDER_HOURS=24
MAX_APPOINTMENTS_PER_DAY=10
PROVIDER_SEARCH_RADIUS_KM=50

# ============================================
# AI (Optional)
# ============================================
AI_ENABLED=false
AI_MODEL=openai/gpt-oss-20b:fastest
AI_REQUEST_TIMEOUT=30s
AI_MAX_TOKENS=512

# ============================================
# WEBSOCKET
# ============================================
WS_PING_INTERVAL=30s
WS_PONG_WAIT=60s
WS_WRITE_WAIT=10s
WS_MAX_MESSAGE_BYTES=8192
WS_SEND_CHANNEL_BUFFER=256
