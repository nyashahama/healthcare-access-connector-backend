# ============================================
# DEVELOPMENT ENVIRONMENT (Local)
# ============================================

ENVIRONMENT=development

# ============================================
# LOCAL DATABASE (PostgreSQL via Docker)
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=app_db
DB_URL=postgres://postgres:replace_me@localhost:5432/app_db?sslmode=disable

# Connection Pool (smaller for local)
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m

# ============================================
# LOCAL REDIS (via Docker)
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_MAX_CONNS=5
REDIS_MIN_IDLE_CONNS=2
REDIS_POOL_TIMEOUT=1s

# ============================================
# LOCAL NATS (via Docker - Optional)
# ============================================
NATS_URL=nats://localhost:4222

# ============================================
# LOCAL EMAIL (Mailpit for testing)
# ============================================
EMAIL_PROVIDER=resend
EMAIL_FROM_ADDRESS=no-reply@example.local
EMAIL_FROM_NAME=Healthcare Access Connector

# Resend API
RESEND_API_KEY=replace_me

# Email Addresses
EMAIL_NOREPLY_ADDRESS=no-reply@example.local
EMAIL_SUPPORT_ADDRESS=support@example.local
EMAIL_HEALTH_ADDRESS=health@example.local

# Mailpit SMTP (catches all emails locally; no auth required)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_USE_TLS=false

# Email Performance
EMAIL_MAX_WORKERS=5
EMAIL_QUEUE_SIZE=50
EMAIL_CONNECTION_POOL_SIZE=2
EMAIL_TIMEOUT=10s
EMAIL_RETRY_MAX_ATTEMPTS=2
EMAIL_RETRY_DELAY=1s

# ============================================
# SECURITY (Dev values - less secure, faster)
# ============================================
JWT_SECRET=dev-jwt-secret-replace-me-now

JWT_EXPIRY_HOURS=24

# Bcrypt (lower cost for faster dev)
BCRYPT_COST=4

# Login Security (relaxed for dev)
LOGIN_MAX_ATTEMPTS=10
LOGIN_LOCKOUT_MINS=1

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=8080
LOG_LEVEL=debug
TIMEOUT_SECONDS=30

# Server Timeouts
READ_TIMEOUT=10s
WRITE_TIMEOUT=10s
IDLE_TIMEOUT=60s

# ============================================
# CORS (Allow all in dev)
# ============================================
ALLOWED_ORIGINS=*

# ============================================
# RATE LIMITING (Relaxed for dev)
# ============================================
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200

# ============================================
# CACHING
# ============================================
CACHE_ENABLED=true
CACHE_TTL_MINUTES=5
CACHE_DEFAULT_TTL=2m
CACHE_USER_TTL=5m
CACHE_SESSION_TTL=1m
CACHE_TOKEN_TTL=1m

# ============================================
# PERFORMANCE MONITORING (Disabled in dev)
# ============================================
METRICS_ENABLED=false
METRICS_PORT=9090
PROFILING_ENABLED=true
PROFILING_PORT=6060

# Email Monitoring
EMAIL_METRICS_ENABLED=false
EMAIL_LOG_LEVEL=debug

# ============================================
# TEMPLATES
# ============================================
EMAIL_TEMPLATES_DIR=./internal/email/templates/assets
EMAIL_DEFAULT_LOCALE=en

# ============================================
# FRONTEND
# ============================================
FRONTEND_URL=http://localhost:3000

# ============================================
# HTTP CLIENT
# ============================================
HTTP_CLIENT_TIMEOUT=10s
HTTP_MAX_IDLE_CONNS=50
HTTP_MAX_CONNS_PER_HOST=5
HTTP_IDLE_CONN_TIMEOUT=60s

# ============================================
# AI (Optional)
# ============================================
AI_ENABLED=false
AI_MODEL=openai/gpt-oss-20b:fastest
AI_REQUEST_TIMEOUT=30s
AI_MAX_TOKENS=512

# ============================================
# WEBSOCKET
# ============================================
WS_PING_INTERVAL=30s
WS_PONG_WAIT=60s
WS_WRITE_WAIT=10s
WS_MAX_MESSAGE_BYTES=8192
WS_SEND_CHANNEL_BUFFER=256
